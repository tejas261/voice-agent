# No-key mode copies matched source clauses. For natural paraphrases, use groq
# with your API key. Retrieval and speech stay local; selected text goes to Groq.
LLM_PROVIDER=extractive
# ollama is fully local; groq uses your account's quota/billing.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_TOKENS=600
KB_PATH=data/policy_booklets.txt
INDEX_PATH=runtime/knowledge.sqlite3
RETRIEVAL_MODE=auto
# auto uses local semantic retrieval + reranking when both models are present.
# hybrid requires both; lexical runs without model dependencies/downloads.
EMBEDDING_DIR=models/multilingual-e5-small
RERANKER_DIR=models/bge-reranker-v2-m3
# Generation retrieval: sentence-aware windows, 15% overlap on long clauses.
CHUNK_SIZE_WORDS=160
CHUNK_OVERLAP_WORDS=24
RETRIEVAL_CANDIDATES=16
RETRIEVAL_TOP_K=5
CONTEXT_MAX_SOURCES=8
CONTEXT_MAX_CHARS=5000

# Without a token the API only accepts loopback clients and same-origin requests.
# Set a strong token and use HTTPS if exposing this beyond localhost.
API_TOKEN=

# ./run.sh enables voice; direct Uvicorn runs use this setting.
# Install requirements/voice.lock and run scripts/setup_models.py first.
VOICE_ENABLED=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CPU_THREADS=4
KOKORO_MODEL=models/kokoro-v1.0.int8.onnx
KOKORO_VOICES=models/voices-v1.0.bin
TTS_EN_VOICE=af_heart
TTS_HI_VOICE=hf_alpha
MAX_AUDIO_SECONDS=20

# Optional local Qwen3-TTS cloning on Apple Silicon. See README setup steps.
QWEN_PYTHON=.venv-qwen/bin/python
QWEN_MODEL_DIR=models/qwen3-tts-natural
VOICES_DIR=runtime/voices
QWEN_TIMEOUT_SECONDS=180
